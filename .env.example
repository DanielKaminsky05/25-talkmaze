# Base URL used for building absolute links / redirects (e.g. http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role key — server/webhooks only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# LessonSpace (external video rooms)
LESSONSPACE_API_KEY=
LESSONSPACE_WEBHOOK_URL=

# Resend (transactional email)
RESEND_API_KEY=
